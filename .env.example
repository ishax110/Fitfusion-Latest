# ══════════════════════════════════════════════════════
#  FitFusion — Environment Variables
#  Copy this file to .env and fill in the values
#  NEVER commit .env to version control
# ══════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_DB=fitfusion
POSTGRES_USER=fitfusion_user
POSTGRES_PASSWORD=your_strong_db_password_here

# ── Spring Boot Backend ───────────────────────────────
# Must be at least 32 characters long, random string
JWT_SECRET=replace-with-a-very-long-random-string-at-least-32-chars

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.railway.app

# ── Groq AI API Key ───────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Frontend ──────────────────────────────────────────
# Point to your deployed backend URL
VITE_API_BASE_URL=https://your-backend.railway.app
